{
  "permissions": {
    "allow": [
      "Bash(dune *)",
      "Bash(opam *)",
      "Bash(ollama *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-ocaml.sh",
            "timeout": 60,
            "statusMessage": "Typechecking (dune build @check)…"
          }
        ]
      }
    ]
  }
}
